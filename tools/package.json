{
  "name": "mlp-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base=/tools/",
    "test:amortization": "tsc -p tsconfig.test.json && node scripts/check-amortization.mjs",
    "preview": "vite preview",
